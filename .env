# Database configuration
DB_ENGINE=postgres
DB_NAME=aghamazing_db
DB_USER=admin
DB_PASSWORD=password123
DB_HOST=localhost
DB_PORT=5433

# Django settings
DJANGO_SECRET_KEY=django-insecure-staging-key-for-development-and-testing-purpose-only
