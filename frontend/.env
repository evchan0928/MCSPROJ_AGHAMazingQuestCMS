# This tells the frontend where to find the backend API
# If accessing from other devices, replace 'localhost' with your computer's IP address
# REACT_APP_BACKEND_API_URL=http://172.19.91.23:8080/api
# For local development (when backend is on localhost), uncomment the next line:
# REACT_APP_BACKEND_API_URL=http://localhost:8000/api
# For nginx proxy setup:
REACT_APP_BACKEND_API_URL=http://localhost/api

# TinyMCE configuration - using null to enable basic features without API key
REACT_APP_TINYMCE_API_KEY=