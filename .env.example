# Example environment variables for deployment
# Copy to .env and fill values before deploying

# Database configuration - Remote host
DB_NAME=aghamazing_db
DB_USER=admin
DB_PASSWORD=password123
DB_HOST=your-neon-db-host.aws-neon.tech
DB_PORT=5432

# Django settings
DJANGO_SECRET_KEY=django-insecure-replace_with_a_secure_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-host-name

# CORS settings for frontend
CORS_ALLOWED_ORIGINS=http://your-domain:3000
CSRF_TRUSTED_ORIGINS=http://your-domain:3000,http://your-domain:8000